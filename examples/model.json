{
  "schema_version": 2,
  "name": "example-multitask-ranking",
  "dtype": "fp16",
  "dense_features": 32,
  "embedding_inputs": [
    {"name": "user_id", "dim": 64, "pooling": "none"},
    {"name": "item_id", "dim": 64, "pooling": "none"},
    {"name": "category", "dim": 32, "pooling": "sum"}
  ],
  "dense_mlp": [128, 64],
  "interaction": {"kind": "dot", "projection_dim": 64},
  "sequence_encoder": null,
  "towers": [
    {"name": "ctr", "hidden_sizes": [128, 64], "output_dim": 1},
    {"name": "cvr", "hidden_sizes": [64, 32], "output_dim": 1}
  ]
}
